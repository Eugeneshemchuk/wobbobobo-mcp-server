# Same Supabase Postgres instance the n8n workflow already uses.
# Use the Session Pooler connection string (IPv4-compatible), e.g.:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Same Anthropic key you created a Header Auth credential for in n8n.
ANTHROPIC_API_KEY=
