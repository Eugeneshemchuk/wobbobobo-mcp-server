# Telegram - token from @BotFather, your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# For the local Bot API server (docker-compose): https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Transcription runs locally (faster-whisper) - no key needed
# WHISPER_MODEL=small
WHISPER_LANGUAGE=en

# TikTok developer app (Login Kit + Content Posting API, scope video.upload)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# QUOTE_COOLDOWN_DAYS=30
# JOB_RETENTION_DAYS=30

# Style and effects (incl. the fractal overlay) are in content/style.toml
# TARGET_MAX_S=45
